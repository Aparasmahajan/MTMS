# MTMS API — environment.
#
# Copy to api.env next to the JAR (or to /etc/mtms/api.env for systemd) and fill in the four
# values marked CHANGE. Nothing else has to be touched for a first deployment.
#
#   cp deploy/api.env.example ~/mtms/api.env
#
# This file is read two ways and the difference matters exactly once, over quoting:
#
#   * `scripts/release.sh restart` SOURCES it with `set -a`, so it runs through bash.
#   * systemd reads it as an EnvironmentFile, which is not a shell.
#
# Values are quoted below so the same file works for both. systemd strips surrounding quotes;
# bash needs them. Leave them on — see DATABASE_URL, where dropping them is the single most
# expensive mistake in this file.
#
# NEVER COMMIT THE FILLED-IN COPY. It holds a database password and the key that signs every
# session.

SPRING_PROFILES_ACTIVE=mysql

# --- Database ---------------------------------------------------------------
#
# CHANGE the host and the password.
#
# THE QUOTES ARE NOT OPTIONAL. The URL contains `&`, which is bash's background-job operator.
# Sourced unquoted, this line runs as three separate commands, the variable is never set at
# all, and the application falls back to its built-in defaults — so the failure arrives much
# later as `Access denied for user 'mtms'@'localhost'`, pointing at the wrong thing entirely.
#
# The giveaway is a line like `[2]+  Done   characterEncoding=utf8` when the file is sourced.
# Check it survived with: echo "$DATABASE_URL"  — it must end in rewriteBatchedStatements=true
#
# `sessionVariables=time_zone='+00:00'` is load-bearing, not decoration. MySQL has no
# time-zone-aware column type; every DATETIME(6) in this schema holds UTC by convention, and
# the connection has to agree or the driver converts using whatever zone the server happens to
# be in — and every audit timestamp is silently wrong by that offset. The %2B is a URL-encoded
# plus sign; a literal + would be read as a space.
DATABASE_URL="jdbc:mysql://localhost:3306/mtms?sessionVariables=time_zone='%2B00:00'&characterEncoding=utf8&rewriteBatchedStatements=true"
DATABASE_USER="mtms"
DATABASE_PASSWORD="CHANGE-ME"

# Sized for 100–200 people. Raising it is usually the wrong fix: a pool larger than the
# database can serve in parallel moves the queue from the application into MySQL, where it is
# harder to see. MySQL's own default max_connections is 151.
DATABASE_POOL_SIZE="16"

# --- Sessions ---------------------------------------------------------------
#
# CHANGE this. 32 characters minimum — the service refuses to start on a shorter one.
#
#   openssl rand -base64 48
#
# Generate once and keep it. Changing it logs everyone out, because every access token already
# issued stops verifying.
MTMS_SECURITY_JWT_SECRET="CHANGE-ME-openssl-rand-base64-48"

# FALSE ON PLAIN HTTP, and this is trap 1 in DEPLOYMENT.md.
#
# True tells the browser to send the login cookie only over HTTPS. On an http:// address the
# browser accepts the login, silently throws the cookie away, and the next page bounces back to
# the sign-in screen with NO error anywhere — not in the log, not in the console. Set it true
# the moment HTTPS actually serves, and not before; left false under HTTPS it is a real
# weakness rather than untidiness.
#
# Note the mysql profile sets this to true, so this line is doing real work.
MTMS_SECURITY_SECURE_COOKIES="false"

# --- Addresses --------------------------------------------------------------
#
# CHANGE both to the address a user's browser actually types.
#
# MTMS_APP_BASE_URL is the whole address invitation links are built from, and the console
# sends it on unchanged. Get it wrong and every invitation issued until somebody notices is a
# dead link — and since the server keeps only a hash of each token, the repair is to reissue
# them, not to resend them.
#
# An origin is scheme, host and port and nothing else. No path, no trailing slash.
MTMS_APP_BASE_URL="http://localhost:6010"
MTMS_CORS_ALLOWED_ORIGINS="http://localhost:6010"

# Loopback only. With the recommended setup the web app proxies /api/v1/... to the API, so
# nothing outside ever needs to reach this port. Comment it out if you are exposing the API
# directly — in which case CORS above stops being decorative.
SERVER_ADDRESS="127.0.0.1"
SERVER_PORT="6011"

# --- Redis and Kafka, switched off ------------------------------------------
#
# The mysql profile turns both on. If you do not have them, these three lines turn them back
# off — and the third one is the one people miss: without the autoconfigure exclusion the
# health endpoint reports DOWN because it cannot reach Redis, even though the application works
# perfectly. Any load balancer probing /actuator/health will take the service out of rotation.
MTMS_CACHE_TYPE="memory"
MTMS_EVENTS_PUBLISHER="logging"
SPRING_AUTOCONFIGURE_EXCLUDE="org.springframework.boot.autoconfigure.data.redis.RedisAutoConfiguration,org.springframework.boot.autoconfigure.kafka.KafkaAutoConfiguration"

# --- Optional ---------------------------------------------------------------

# Where a defect's ticket key links to. Defects reference tickets, never copy them.
# MTMS_TICKET_BASE_URL="https://tms.internal/browse"

# MTMS_SEED_ON_EMPTY_DATABASE no longer does anything — the seeder it controlled was deleted
# on 16 Sept. A fresh database is bootstrapped with deploy/bootstrap.sql instead.
