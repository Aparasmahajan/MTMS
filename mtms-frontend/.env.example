# Where the Spring Boot service lives.
#
# NEXT_PUBLIC_API_BASE_URL is used by the browser and is inlined at build time — the
# NEXT_PUBLIC_ prefix is what puts it in the bundle at all, not a naming convention. It
# must be an address the user's machine can reach.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Used by server components only. Inside a container network the service is often reachable
# at a name the browser cannot resolve, so it is set separately. Falls back to the public
# one when unset, which is right for local development.
# API_BASE_URL=http://api:8080

# Whatever origin this app is served from must appear in the service's
# mtms.cors.allowed-origins, or the browser will refuse every request that carries
# credentials — and it will not say why.
