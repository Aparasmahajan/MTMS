# Copy to .env.local for development, or set these in the deployment environment.

# Signs the access token. REQUIRED in production — the app refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the file-backed store lives. Defaults to ./data/tracker.json.
# Delete the file to reseed from lib/server/seed.ts.
# TRACKER_DATA_DIR=
# TRACKER_STORE_PATH=

# Prefix for the links in the defect table's Ticket column.
# TICKET_BASE_URL=https://tms.internal/browse

# Bearer token the drift agents present to POST /api/v1/drift/reports. Agents run on the
# servers and have no session, so this is how they authenticate. Unset means no agent can
# report; a signed-in user with prod.confirm can still post by hand.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DRIFT_INGEST_TOKEN=

# Write requests per user per minute.
# WRITE_RATE_LIMIT=300

# --- Part 6: the production seams. Each is optional; without it the app uses a local
# --- default, and each driver names the npm package to install if you set it without one.

# Postgres instead of data/tracker.json. Needs `npm install pg`.
# The document moves into one row with a revision column, so two instances cannot lose
# each other's writes. NOT YET RUN AGAINST A DATABASE — see pending.md.
# DATABASE_URL=postgres://user:pass@localhost:5432/mtms

# Redis in front of the snapshot projection. Needs `npm install ioredis`.
# Entries are keyed by store revision and by user, so there is no invalidation to get wrong
# and no chance of serving one user's permissions to another.
# REDIS_URL=redis://localhost:6379
# REDIS_TTL_SECONDS=900

# Kafka for the six domain events. Needs `npm install kafkajs`.
# Events are written to an outbox in the same store write as the change, then drained —
# so a broker outage never loses one. Consumers must be idempotent.
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=mtms.domain-events
