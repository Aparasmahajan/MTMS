# Copy to .env.local for development, or set these in the deployment environment.

# Signs the access token. REQUIRED in production — the app refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the file-backed store lives. Defaults to ./data/tracker.json.
# Delete the file to reseed from lib/server/seed.ts.
# TRACKER_DATA_DIR=
# TRACKER_STORE_PATH=

# Prefix for the links in the defect table's Ticket column.
# TICKET_BASE_URL=https://tms.internal/browse

# Bearer token the drift agents present to POST /api/v1/drift/reports. Agents run on the
# servers and have no session, so this is how they authenticate. Unset means no agent can
# report; a signed-in user with prod.confirm can still post by hand.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DRIFT_INGEST_TOKEN=

# Write requests per user per minute.
# WRITE_RATE_LIMIT=300
